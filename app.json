{
  "expo": {
    "name": "ElectriKa",
    "slug": "electrika",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "electrika",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ng.electrika.app",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ng.electrika.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ElectriKa uses your location to fill in your address when you ask for help, and to share an engineer's position with the customer while they are on the way.",
          "locationAlwaysAndWhenInUsePermission": "While you are on the way to a job, ElectriKa shares your location with the customer, even with your screen off, until you tap \"I've arrived\".",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0051A2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ElectriKa uses your photos for your profile picture and to show us the problem.",
          "cameraPermission": "ElectriKa uses the camera for job photos and to show us the problem."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://electrika.ng/api"
    }
  }
}
